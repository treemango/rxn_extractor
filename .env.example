# Ollama (Local LLM) Settings
# These defaults are optimized for standard workstations (e.g. 5GB+ VRAM).
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT=180
# Context window in tokens. 16384 requires ~1.2GB KV Cache, allowing the 
# 3B model to fit 100% inside a standard 4GB-5GB GPU for maximum speed.
OLLAMA_NUM_CTX=16384

# Extraction behavior
MAX_RETRIES=3
TEMPERATURE=0.3
TEMPERATURE_INCREMENT=0.2
CONFIDENCE_THRESHOLD=3
ENABLE_VALIDATION=true

# API / HITL dashboard
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=*

# Batch processing
CHECKPOINT_INTERVAL=50
CONTINUE_ON_ERROR=true

# Logging
LOG_DIR=logs
LOG_FILE=rxn_extractor.log
LOG_LEVEL=INFO
