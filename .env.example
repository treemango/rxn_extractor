# Ollama (Local LLM) Settings
# These defaults are optimized for standard workstations (e.g. 5GB+ VRAM).
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT=180
# Context window: 24576 tokens (~18,000 words). Covers large research papers.
# VRAM: 2.2GB weights + 1.35GB KV cache (24K) + 0.4GB CUDA = ~3.95GB on 5GB GPU.
OLLAMA_NUM_CTX=24576

# Extraction behavior
MAX_RETRIES=3
TEMPERATURE=0.3
TEMPERATURE_INCREMENT=0.2
CONFIDENCE_THRESHOLD=3
ENABLE_VALIDATION=true

# API / HITL dashboard
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=*

# Batch processing
CHECKPOINT_INTERVAL=50
CONTINUE_ON_ERROR=true

# Logging
LOG_DIR=logs
LOG_FILE=rxn_extractor.log
LOG_LEVEL=INFO
