# Ollama (Local LLM) Settings
# These defaults are optimized for standard workstations (e.g. 5GB+ VRAM).
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT=180
# Context window: 32768 tokens (~25,000 words). Covers full research papers.
# VRAM: 9GB weights + 2GB KV cache (32K) = ~11GB on 32GB GPU.
NUM_CTX=32768
OLLAMA_NUM_CTX=32768

# Extraction behavior
MAX_RETRIES=3
TEMPERATURE=0.3
TEMPERATURE_INCREMENT=0.2
CONFIDENCE_THRESHOLD=3
ENABLE_VALIDATION=true

# API / HITL dashboard
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=*

# Batch processing
CHECKPOINT_INTERVAL=50
CONTINUE_ON_ERROR=true

# Logging
LOG_DIR=logs
LOG_FILE=rxn_extractor.log
LOG_LEVEL=INFO
