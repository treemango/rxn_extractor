# Database
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mydb
DB_URL=sqlite:///rxn_extractor.db

# Ollama
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_TIMEOUT=180

# Extraction
MAX_RETRIES=3
TEMPERATURE=0.3
TEMPERATURE_INCREMENT=0.2
CONFIDENCE_THRESHOLD=3
ENABLE_VALIDATION=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=*

# Batch
CHECKPOINT_INTERVAL=50
CONTINUE_ON_ERROR=true

# Logging
LOG_DIR=logs
LOG_FILE=rxn_extractor.log
LOG_LEVEL=INFO
